# Copie para .env e ajuste

# MySQL (producao/TCC). Para testar rapido sem MySQL, deixe a linha do SQLite.
DATABASE_URL=mysql+pymysql://energyguard:troque_esta_senha@localhost:3306/energyguard
# DATABASE_URL=sqlite:///./energyguard.db

# Chave compartilhada com o ESP32 e o Streamlit (header X-API-Key). Vazio = sem autenticacao.
API_KEY=troque-esta-chave

# Origens permitidas no CORS (separadas por virgula). "*" libera tudo.
CORS_ORIGINS=*

# Isolation Forest
MODEL_PATH=models/isolation_forest.joblib
MIN_TRAIN_SAMPLES=200
RETRAIN_EVERY=500
TRAIN_WINDOW=20000
CONTAMINATION=0.02
N_ESTIMATORS=200

# ---- Alertas ----
# Avisar tambem quando o Isolation Forest marcar anomalia (no maximo 1 aviso a cada N segundos)
NOTIFY_ON_ANOMALY=true
ANOMALY_ALERT_COOLDOWN_S=900
# Segundos sem receber leitura para considerar o ESP32 offline
OFFLINE_AFTER_S=120

# ---- Telegram (opcional) ----
# 1) Fale com @BotFather e crie um bot (/newbot) -> token
# 2) Mande uma mensagem para o seu bot e abra https://api.telegram.org/bot<TOKEN>/getUpdates -> chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- E-mail (opcional; no Gmail use uma "senha de app") ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ---- MySQL na nuvem (Aiven) ----
# Cole aqui a "Service URI" do Aiven (mysql://usuario:senha@host:porta/defaultdb?ssl-mode=REQUIRED):
# o backend converte sozinho para o formato certo e liga a conexão criptografada.
# Para também conferir o certificado do servidor, baixe o "CA certificate" e use UM destes:
# DATABASE_SSL_CA=ca.pem
# DATABASE_SSL_CA_PEM=<conteudo do ca.pem>
